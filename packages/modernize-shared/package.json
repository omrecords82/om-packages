{
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "name": "@om/modernize-shared",
  "description": "Modernize customizer config/context extracted for OM packages.",
  "repository": {
    "type": "git",
    "url": "https://github.com/omrecords82/om-packages.git",
    "directory": "packages/modernize-shared"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo && tsc -b",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "eslint .",
    "pack:check": "corepack pnpm pack --dry-run",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b --pretty false"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20",
    "@mui/material": ">=6 <10"
  },
  "devDependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "@mui/material": "7.3.5",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1"
  }
}
