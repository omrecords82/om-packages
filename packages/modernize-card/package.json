{
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "name": "@om/modernize-card",
  "description": "Modernize shared cards + PageContainer/Scrollbar extracted for OM packages.",
  "repository": {
    "type": "git",
    "url": "https://github.com/omrecords82/om-packages.git",
    "directory": "packages/modernize-card"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo && tsc -b",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "eslint .",
    "pack:check": "corepack pnpm pack --dry-run",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b --pretty false"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20",
    "@mui/material": ">=6 <10",
    "@emotion/react": ">=11",
    "@emotion/styled": ">=11",
    "@tabler/icons-react": ">=3",
    "react-helmet": ">=6",
    "simplebar-react": ">=3"
  },
  "devDependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "@mui/material": "7.3.5",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@om/modernize-shared": "workspace:*",
    "@tabler/icons-react": "3.34.0",
    "react-helmet": "6.1.0",
    "@types/react-helmet": "6.1.11",
    "simplebar-react": "3.3.2",
    "simplebar": "6.3.2"
  },
  "dependencies": {
    "@om/modernize-shared": "workspace:*"
  }
}
