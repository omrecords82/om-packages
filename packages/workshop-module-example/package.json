{
  "name": "@om/workshop-module-example",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal OM Workshop example module using contracts, SDK, and module UI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/omrecords82/om-packages.git",
    "directory": "packages/workshop-module-example"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo && tsc -b",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "eslint .",
    "pack:check": "corepack pnpm pack --dry-run",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@om/workshop-contracts": "workspace:*",
    "@om/workshop-module-ui": "workspace:*",
    "@om/workshop-sdk": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "jsdom": "29.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
